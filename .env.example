# Copy to .env.local. Never place secrets in NEXT_PUBLIC_* variables.
APP_URL=http://localhost:3000
# Local Docker-only credentials; never reuse outside local development.
DATABASE_URL=postgresql://ticketsquare_app:local-app-only@127.0.0.1:5433/ticketsquare
MIGRATION_DATABASE_URL=postgresql://ticketsquare:local-development-only@127.0.0.1:5433/ticketsquare
# Integration tests create/drop only their own uniquely named database on loopback.
TEST_DATABASE_URL=postgresql://ticketsquare:local-development-only@127.0.0.1:5433/postgres

# Generate locally: openssl rand -base64 48. Never reuse the CI test value.
BETTER_AUTH_SECRET=replace-me-with-a-random-secret-at-least-32-characters

# First payment slice is TEST ONLY. Leave disabled until reviewing hosted checkout.
PAYSTACK_MODE=disabled
# Set locally to your sk_test_... value when PAYSTACK_MODE=test. Never use a live key.
PAYSTACK_SECRET_KEY=

# Test ticket encryption: a separate random 32-byte key (64 hex characters).
# JSON keyring supports keeping previous keys during rotation. Never use NEXT_PUBLIC.
TICKET_ACTIVE_KEY_ID=local-v1
TICKET_ENCRYPTION_KEYS=
