# Copy to .env.local. Never place secrets in NEXT_PUBLIC_* variables.
APP_URL=http://localhost:3000
# Local Docker-only credentials; never reuse outside local development.
DATABASE_URL=postgresql://ticketsquare_app:local-app-only@127.0.0.1:5433/ticketsquare
MIGRATION_DATABASE_URL=postgresql://ticketsquare:local-development-only@127.0.0.1:5433/ticketsquare
# Integration tests create/drop only their own uniquely named database on loopback.
TEST_DATABASE_URL=postgresql://ticketsquare:local-development-only@127.0.0.1:5433/postgres
